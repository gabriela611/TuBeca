// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Universidad {
  id           String   @id @default(cuid())
  nombre       String   @unique
  ciudad       String
  departamento String
  sitioWeb     String?
  logoUrl      String?
  tipo         String   // "publica" | "privada"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  becas Beca[]

  @@map("universidades")
}

model Beca {
  id                    String    @id
  idBeca                String    @unique @map("id_beca")
  universidad           String
  universidadRel        Universidad? @relation(fields: [universidadId], references: [id])
  universidadId         String?   @map("universidad_id")
  municipioAplicacion   String?   @map("municipio_aplicacion")
  nombreBeca            String    @map("nombre_beca")
  nivelAcademico        String?   @map("nivel_academico")
  areaConocimiento      String?   @map("area_conocimiento")
  modalidad             String?
  descripcion           String?
  tipoFinanciacion      String?   @map("tipo_financiacion")
  porcentaje            String?
  valorBecaCop          Float?    @map("valor_beca_cop")
  cobertura             String?
  edadMinima            Int?      @map("edad_minima")
  edadMaxima            Int?      @map("edad_maxima")
  promedioMinimo        Float?    @map("promedio_minimo")
  puntajeSaber11Minimo  Int?      @map("puntaje_saber11_minimo")
  estratoSocioeconomico String?   @map("estrato_socioeconomico")
  poblacionObjetivo     String?   @map("poblacion_objetivo")
  requisitos            String?
  documentosRequeridos  String?   @map("documentos_requeridos")
  fechaApertura         DateTime? @map("fecha_apertura")
  fechaCierre           DateTime? @map("fecha_cierre")
  estadoConvocatoria    String?   @map("estado_convocatoria")
  enlaceOficial         String?   @map("enlace_oficial")
  fechaActualizacion    DateTime? @map("fecha_actualizacion")
  estadoCalidadDato     String?   @map("estado_calidad_dato")
  observaciones         String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  categorias            BecaCategoria[]
  favoritos             Favorito[]
  reportes              Reporte[]

  @@map("becas")
}

model Categoria {
  id          String @id @default(cuid())
  nombre      String @unique
  descripcion String?

  becas BecaCategoria[]

  @@map("categorias")
}

model BecaCategoria {
  beca        Beca      @relation(fields: [becaId], references: [id], onDelete: Cascade)
  becaId      String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  categoriaId String

  @@id([becaId, categoriaId])
  @@map("beca_categorias")
}

model Usuario {
  id                   String     @id
  email                String     @unique
  puntajeSaber11       Int?       @map("puntaje_saber11")
  promedio             Float?
  estrato              Int?
  edad                 Int?
  recibirRecordatorios Boolean    @default(true) @map("recibir_recordatorios")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  favoritos            Favorito[]

  @@map("usuarios")
}

model Favorito {
  id                   String                 @id @default(cuid())
  usuarioId            String                 @map("usuario_id")
  usuario              Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  becaId               String                 @map("beca_id")
  beca                 Beca                   @relation(fields: [becaId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now()) @map("created_at")

  recordatoriosEnviados RecordatorioEnviado[]

  @@unique([usuarioId, becaId])
  @@map("favoritos")
}

model RecordatorioEnviado {
  id          String   @id @default(cuid())
  favoritoId  String   @map("favorito_id")
  favorito    Favorito @relation(fields: [favoritoId], references: [id], onDelete: Cascade)
  tipo        String
  enviadoEn   DateTime @default(now()) @map("enviado_en")

  @@unique([favoritoId, tipo])
  @@map("recordatorios_enviados")
}

model Reporte {
  id          String   @id @default(cuid())
  becaId      String   @map("beca_id")
  beca        Beca     @relation(fields: [becaId], references: [id], onDelete: Cascade)
  motivo      String
  descripcion String
  ipHash      String   @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reportes")
}
