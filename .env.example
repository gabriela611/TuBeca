# Environment variables template for TuBeca

# 1. Database (Supabase PostgreSQL para producción o SQLite local)
# Para Supabase: copia la cadena de conexión desde Settings -> Database -> Connection string (Node.js / Prisma)
# Ej: "postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# (Opcional si usas connection pooling de Supabase con Prisma)
DIRECT_URL="postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# 2. Supabase Auth (Magic Link y sincronización en la nube)
# Obtén estos valores en el dashboard de tu proyecto en Supabase -> Settings -> API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-de-supabase"

# 3. Dominio de la app (para OpenGraph, sitemap y enlaces para compartir)
APP_URL="https://tubeca.co"

# 4. Recordatorios por correo (Resend) y Cron jobs
RESEND_API_KEY="re_tu_clave_de_resend"
CRON_SECRET="clave_secreta_para_proteger_endpoints_cron"

# 5. Google Gemini API Key para el chatbot vocacional
GEMINI_API_KEY="tu-clave-de-gemini-aqui"
